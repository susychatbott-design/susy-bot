# IMPORTANTE: Copia este archivo a .env.local y completa tus credenciales.
# NUNCA subas .env.local a tu repositorio Git.

# 1. SUPABASE DEDICADO PARA SUSY BOT (Crea un nuevo proyecto en supabase.com o local)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-susy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-susy
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-susy

# 2. INFERENCIA SOBERANA (CERO APIS DE TERCEROS - ON PREMISE GUBERNAMENTAL)
# Apunta al servidor Ollama local (o VPS interno del municipio)
LOCAL_OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.3
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBED_MODEL=nomic-embed-text

# 3. FALLBACKS DE CÃ“DIGO ABIERTO GRATUITOS (Opcionales para pruebas)
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# 4. CONFIGURACIÃ“N DEL SERVIDOR
PORT=3000
NODE_ENV=development